NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/evaltech?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_secure_random_64_character_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Razorpay Integration
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Transactional Email (Multi-Provider: Brevo, Resend, or SMTP)
EMAIL_PROVIDER=auto
BREVO_API_KEY=your_brevo_api_key
RESEND_API_KEY=your_resend_api_key
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASS=your_smtp_password
EMAIL_FROM=EvalTech Examinations <noreply@evaltech.io>

# Optional AI Question Generation
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=your_openai_api_key

# Code Execution & Compiler Sandbox
# Options: 'local_sandbox' (isolated local runner), 'judge0' (Judge0 API / self-hosted), 'piston'
COMPILER_PROVIDER=local_sandbox
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_AUTH_TOKEN=
PISTON_API_URL=http://localhost:2000/api/v2
EXECUTION_TIMEOUT_MS=5000
MAX_SOURCE_CODE_BYTES=65536
MAX_RUN_CODE_PER_MINUTE=15
MAX_SUBMISSIONS_PER_QUESTION=10
