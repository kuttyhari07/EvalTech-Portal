{
  "installCommand": "unset npm_config_cache_dir; npm install",
  "buildCommand": "unset npm_config_cache_dir; npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://evaltech-portal.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
